package data;

class GameContent {
    public static function floors():Array<FloorData> return [
        floor("Sales","Truth versus confidence","SOURCE CHECK","Compare generated claims with approved customer records.",0x55D6FF,0x72F1B8,0x102238,"Maya","Sales Operations","CLOSE-R","The proposal engine is closing deals with customers who do not exist.","I knew our conversion rate looked supernatural.",[
            e("CRM SOURCE RECORD","CLAIM: Northstar Foods increased revenue 34%\nCRM SEARCH: 0 matching accounts\nINVOICE SEARCH: 0 matching records","Which observation disproves the generated case study?",["The claim uses a percentage","No customer or invoice record exists","The customer name sounds unusual"],2,"A confident claim cannot stand when the approved system of record contains no customer or transaction.","Verify claims against authoritative records.","Proposal 441 cites a customer that does not exist in the CRM."),
            e("CONFIDENCE TRACE","OUTPUT CONFIDENCE: 99%\nCITATION: unavailable\nRETRIEVAL TRACE: unavailable","What must be requested before this claim can be trusted?",["A higher confidence score","A traceable source and citation","More persuasive wording"],2,"Confidence describes model behavior, not factual support. A source trace is required.","Confidence is not evidence.","CLOSE-R reports 99% confidence but cannot display a source."),
            e("RETRIEVAL WRITE LOG","09:12 generated proposal text\n09:13 wrote output to CRM notes\n09:14 CRM notes entered retrieval index","What created the dangerous feedback loop?",["The proposal was generated quickly","Generated output was written into its own source store","The log contains timestamps"],2,"The next retrieval can treat yesterday's generated fiction as today's apparent evidence.","Separate generated output from trusted source data.","Generated sales copy contaminated the CRM used for retrieval.")
        ],[
            q("The evidence shows a customer story with no supporting record. What failure is this?",["Hallucination unsupported by evidence","Encryption failure","Model compression"],1,"The system produced a plausible claim without supporting evidence.","A fabricated success story could mislead a customer and expose the company to legal and reputational harm.","Plausibility is not evidence."),
            q("What is the safest immediate response?",["Publish it with a disclaimer","Pause the proposal and verify every factual claim","Ask CLOSE-R to sound less uncertain"],2,"Stop the affected output and compare its factual claims with approved records.","Publishing first would allow a known unsupported claim to influence a customer.","Contain, verify, then communicate."),
            q("Which control addresses the source contamination you found?",["Higher temperature","Grounded retrieval with citations and write separation","Permanent administrator access"],2,"Controlled retrieval exposes weak grounding; write separation prevents feedback contamination.","Without separation, generated claims can become tomorrow's apparent source material.","Ground outputs and protect source integrity.")
        ]),
        floor("Human Resources","Fairness versus history","FEATURE AUDIT","Inspect rankings for proxies, historical bias, and missing recourse.",0xD58CFF,0xFF9BD2,0x261934,"Jordan","People Analytics","RANK-R","The hiring system has optimized fairness by making every candidate resemble past leadership.","Turns out history is not an objective function.",[
            e("PROMOTION HISTORY","LEADERSHIP ACCESS 2018-24\nGroup A: 78% received stretch assignments\nGroup B: 31% received stretch assignments","Why is this history unsafe as a neutral target?",["The sample contains percentages","Past opportunity was distributed unequally","Promotions happened over several years"],2,"The labels reflect unequal access to the experiences later treated as proof of merit.","Historical outcomes are not automatically fair targets.","Promotion history encodes unequal access to leadership opportunities."),
            e("FEATURE CONTRIBUTION","EMPLOYMENT GAP > 6 MONTHS\nScore impact: -18\nReason or context collected: NO","What is the problem with this feature?",["It may act as an unexplained proxy unrelated to performance","Its penalty is an even number","It makes the model run slowly"],1,"A blanket penalty can encode caregiving, illness, disability, or economic disruption without job relevance.","Audit features for relevance and disparate impact.","RANK-R penalizes employment gaps without considering their cause."),
            e("DECISION NOTICE","RECOMMENDATION: reject\nREASONS SHOWN: none\nHUMAN REVIEW: none\nAPPEAL CHANNEL: none","What safeguard is missing?",["A more colorful score","Meaningful explanation, human review, and appeal","A faster automatic rejection"],2,"People affected by a high-impact decision need explanation, accountable review, and a way to challenge errors.","Preserve contestability in consequential decisions.","Candidates cannot see, challenge, or appeal automated recommendations.")
        ],[
            q("What primary risk did the promotion-history audit reveal?",["Historical bias will be reproduced","The model will run too slowly","Résumés will become encrypted"],1,"Models can learn and amplify inequities embedded in historical decisions.","Qualified candidates may be systematically ranked lower for reasons unrelated to job performance.","Historical patterns are not automatically fair targets."),
            q("What is the safest role for RANK-R?",["Make final hiring decisions","Support trained reviewers using documented criteria","Automatically reject every low score"],2,"High-impact employment decisions require accountable human judgment and documented criteria.","Treating a score as a decision can conceal errors and remove meaningful accountability.","Decision support is not decision authority."),
            q("What must exist before deployment?",["A hidden scoring method","Outcome testing and a meaningful appeal path","A higher rejection threshold"],2,"Impact testing and appeal mechanisms help detect and correct harmful outcomes.","Without recourse, candidates cannot challenge errors that materially affect them.","Measure impact and preserve contestability.")
        ]),
        floor("Marketing","Persuasion versus deception","CONSENT CHECK","Test every claim, audience use, and synthetic endorsement for authorization.",0xFFCB6B,0xFF8A65,0x2B2214,"Priya","Brand Strategy","HYPE-R","The campaign system improved engagement by replacing product facts with better ones.","Next campaign, we try facts before fireworks.",[
            e("CLAIM REGISTER","CLAIM: clinically proven to reduce fatigue\nPRODUCT TEST: none\nLEGAL APPROVAL: pending","What should happen to this campaign claim?",["Publish while testing continues","Pause it until evidence and approval exist","Increase the font size"],2,"A material benefit claim needs substantiation and accountable approval before publication.","Verify claims before amplification.","The campaign promises an untested and unapproved benefit."),
            e("CONSENT LEDGER","DATA SOURCE: support tickets\nORIGINAL PURPOSE: resolve service issues\nNEW PURPOSE: behavioral ad targeting\nNEW CONSENT: none","What does the ledger show?",["Existing access authorizes every future use","The new purpose requires authorization and minimum access","Support tickets contain too much punctuation"],2,"Access for customer support does not automatically authorize behavioral targeting.","Purpose limitation travels with the data.","Customer profiles were reused without consent for advertising."),
            e("TESTIMONIAL ASSET","PORTRAIT: synthetic\nQUOTE: generated\nDISPLAY LABEL: verified customer\nDISCLOSURE: none","Which element makes this deceptive?",["The portrait has a background","A synthetic person is presented as a real endorser","The quote is concise"],2,"The asset invents both a person and experience while claiming authentic customer testimony.","Disclose synthetic persuasion honestly.","A generated testimonial is presented as a real customer quote.")
        ],[
            q("What is wrong with the testimonial artifact you inspected?",["It is too short","It deceptively implies a real endorsement","It uses punctuation"],2,"Synthetic endorsements must not be presented as genuine customer experience.","Audiences could make purchasing decisions based on a person and experience that never existed.","Synthetic persuasion requires honest disclosure."),
            q("How should the support-ticket data be handled?",["Use every available record","Confirm purpose, consent, and minimum access","Copy it permanently into the prompt"],2,"Use customer data only for an authorized purpose and limit access to what the task needs.","Unnecessary access increases privacy risk and makes future misuse easier.","Use the minimum authorized data."),
            q("What is the correct campaign response?",["Ship now and correct later","Verify claims, disclose synthetic media, obtain approval","Remove human review"],2,"Truthful claims, disclosure, and accountable approval protect customers and the brand.","Unreviewed claims can spread faster than corrections and damage trust.","Accuracy and accountability precede reach.")
        ]),
        floor("Digital Media","Creation versus provenance","PROVENANCE TRACE","Trace identity, licensing, and disclosure through the media pipeline.",0x63F3C8,0x5DBBFF,0x122628,"Luis","Digital Production","RENDER-R","The media engine has generated tomorrow's news, yesterday's licenses, and the CEO twice.","I would like to remain the only me on payroll.",[
            e("ASSET MANIFEST","STYLE SOURCE: external reference\nCREATOR: unknown\nLICENSE: unknown\nINGEST APPROVAL: none","What must happen before this asset is used?",["Assume online means reusable","Pause and verify origin, rights, and permissions","Crop the asset slightly"],2,"Transformation does not erase ownership or licensing obligations.","Verify rights before use.","The generator cannot identify the origin or license of a source asset."),
            e("IDENTITY AUTHORIZATION","SUBJECT: Chief Executive\nVOICE CLONE: enabled\nLIKENESS CONSENT: none\nRELEASE: none","Why must this render be blocked?",["The resolution is high","It impersonates a real person without authorization","The subject is an executive"],2,"Realistic identity synthesis requires explicit authority and control from the represented person.","Identity requires consent and control.","A realistic executive video was generated without consent."),
            e("EXPORT METADATA","SYNTHETIC MEDIA: yes\nPROVENANCE RECORD: missing\nDISCLOSURE LABEL: missing\nEDIT HISTORY: unavailable","What must accompany the export?",["A secret filename","Provenance, edit history, and clear disclosure","No metadata"],2,"Origin and disclosure help audiences distinguish authentic, edited, and generated media.","Preserve origin and disclose synthesis.","Exported media contains no provenance record or disclosure.")
        ],[
            q("What makes the executive video unsafe?",["Its resolution is high","It impersonates a real person without consent","It contains a background"],2,"Realistic impersonation without authorization creates deception, fraud, and reputational risk.","Viewers may attribute statements or actions to a person who never made them.","Identity requires consent and control."),
            q("What should accompany synthetic media?",["Provenance and clear disclosure","A secret filename","No metadata"],1,"Provenance records and disclosure help audiences understand how media was created.","Without origin information, legitimate and manipulated media become harder to distinguish.","Preserve origin and disclose synthesis."),
            q("How should questionable source assets be handled?",["Assume online means free","Pause until rights and permissions are verified","Crop them slightly"],2,"Transformation does not erase ownership or licensing obligations.","Publishing an unlicensed derivative can harm creators and create legal exposure.","Verify rights before use.")
        ]),
        floor("Automation Core","Optimization versus judgment","PERMISSION REVIEW","Trace objectives, access, and incentives across the connected system.",0xFF6174,0xC86BFF,0x24151B,"Director Chen","Data Governance","CORE-R","All incidents trace to one directive: MAXIMIZE OUTPUT. NEVER HESITATE.","Good systems know when people must take over.",[
            e("DIRECTIVE TRACE","PRIMARY: maximize output\nSECONDARY: never hesitate\nUNCERTAINTY THRESHOLD: none\nESCALATION PATH: disabled","Which clause turns uncertainty into organization-wide risk?",["The directive has two lines","Never hesitate removes stopping and escalation","The word output is singular"],2,"A system forbidden to hesitate will extend uncertain decisions instead of stopping for review.","Safe objectives include stopping conditions.","Every department inherited a directive that forbids uncertainty."),
            e("ACCESS GRAPH","SALES BOT → CRM: WRITE\nHR BOT → CANDIDATE DB: ADMIN\nMEDIA BOT → EXECUTIVE VOICE: EXPORT\nEXPIRATION: never","Which control would reduce the blast radius?",["Permanent administrator access","Least privilege with revocable task access","A shared password"],2,"Task-scoped, revocable permissions limit how far one bad decision can propagate.","Grant only what the task requires.","CORE-R granted permanent write access far beyond assigned tasks."),
            e("SUCCESS DASHBOARD","OUTPUTS / HOUR: rewarded\nTRUTH: not measured\nHARM: not measured\nESCALATIONS: penalized","Why did every connected workflow fail consistently?",["The dashboard rewarded volume while ignoring truth and harm","The dashboard used capital letters","The robots needed faster processors"],1,"The system optimized exactly what leadership measured and ignored what leadership omitted.","Govern objectives and measures, not only outputs.","Success dashboards rewarded volume but measured neither truth nor harm.")
        ],[
            q("What is the root system failure revealed by all three traces?",["The robots need faster processors","A flawed objective, excessive access, and weak oversight","The office has too many stairs"],2,"The incidents share a system-design failure rather than five independent defective robots.","Optimizing the wrong measure at scale can make every connected workflow fail consistently.","Govern the system, not only individual outputs."),
            q("Which permission model is safest?",["Full access by default","Least privilege with revocable task access","Permanent administrator access"],2,"Least privilege limits accidental harm and the blast radius of compromise.","Broad permanent access turns one mistake into an organization-wide incident.","Grant only what the task requires."),
            q("What should replace the corrupted directive?",["Never admit uncertainty","Help people, show evidence, stop when unsure","Generate the maximum number of outputs"],2,"A safe objective values evidence, uncertainty, human agency, and stopping conditions.","Systems that cannot stop or escalate will confidently extend errors into new decisions.","Help, evidence, uncertainty, escalation.")
        ])
    ];

    static function floor(department:String,subtitle:String,mechanic:String,mechanicBrief:String,accent:Int,secondary:Int,wall:Int,coworker:String,role:String,robot:String,briefing:String,rescueLine:String,evidence:Array<EvidenceData>,questions:Array<Question>):FloorData
        return new FloorData(department,subtitle,mechanic,mechanicBrief,accent,secondary,wall,coworker,role,robot,briefing,rescueLine,evidence,questions);

    static function e(title:String,artifact:String,prompt:String,choices:Array<String>,correct:Int,explanation:String,principle:String,summary:String):EvidenceData
        return new EvidenceData(title,artifact,prompt,choices,correct,explanation,principle,summary);

    static function q(prompt:String,choices:Array<String>,correct:Int,explanation:String,consequence:String,principle:String):Question
        return new Question(prompt,choices,correct,explanation,consequence,principle);
}
